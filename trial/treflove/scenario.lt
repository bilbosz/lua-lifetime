-- trial/treflove/scenario.lt: the scenarios of task 009, run by
-- trial/treflove/run.lua inside the "lifetime" universe of harness.lua
-- (transpiled like the slice; `app`, `class` and `trial_log` are the
-- universe's globals). Not Treflove code. Each function writes to the log
-- with `trial_log`; a line starting with "> " names the statement that
-- runs next, so every death in the log sits under the statement that
-- caused it. run.lua compares each log, whole, with its expected sequence.
local scenario = {}

local FormScreen = require("ui.form-screen")
local Input = require("ui.input")

local function count_entries(t)
    local n = 0
    for _ in pairs(t) do
        n = n + 1
    end
    return n
end

-- Test case 1: connect, log in, then each side removes its connection.
-- ConnectionManager:remove ends in one destroy(connection).
function scenario.teardown(harness, env)
    local client = harness.new_app(env, "client")
    local server = harness.new_app(env, "server")
    trial_log("> connect")
    local client_connection, server_connection = harness.connect(env, client, server)
    trial_log("> server frame")
    harness.frame(env, server)
    trial_log("> client frame")
    harness.frame(env, client)
    local session = client.session
    local login = session._login
    local upload_rp = client.asset_manager._upload_asset_rp[session]
    local channel = client_connection:get_in_channel()
    trial_log("> client: connection_manager:remove(connection)")
    harness.disconnect(env, client, client_connection)
    trial_log("> server: connection_manager:remove(connection)")
    harness.disconnect(env, server, server_connection)
    -- After the cascade: tombstones, not nil (docs/02-semantics.md,
    -- "Tombstones"); the fields the callbacks clear by hand are nil.
    trial_log("client connection alive: " .. tostring(lifetime.alive(client_connection)))
    trial_log("session alive: " .. tostring(lifetime.alive(session)) .. ", login alive: " .. tostring(lifetime.alive(login)))
    trial_log("app.session: " .. tostring(client.session) .. ", back stack depth: " .. #client.backstack_manager._stack)
    trial_log("in channel released: " .. tostring(channel._released))
    trial_log("connection manager empty: " .. tostring(next(client.connection_manager:get_connections()) == nil))
    -- The per-session tables of AssetManager are weak: until the collector
    -- finds the dead session unreferenced, its entry holds a tombstone.
    local entry = client.asset_manager._upload_asset_rp[session]
    trial_log("upload entry before collect: " .. tostring(entry == upload_rp) .. ", alive: " .. tostring(lifetime.alive(entry)))
    entry, upload_rp = nil, nil
    session, login, client_connection, server_connection = nil, nil, nil, nil
    trial_log("> collectgarbage(\"collect\") twice")
    collectgarbage("collect")
    collectgarbage("collect")
    trial_log("upload entries after collect: " .. count_entries(client.asset_manager._upload_asset_rp))
end

-- Idiom C: the back key logs out; destroy(period) pops nothing twice. Then
-- the disconnect takes the login screen the logout showed.
function scenario.logout(harness, env)
    local client = harness.new_app(env, "client")
    local server = harness.new_app(env, "server")
    trial_log("> connect, server frame, client frame")
    local client_connection, server_connection = harness.connect(env, client, server)
    harness.frame(env, server)
    harness.frame(env, client)
    trial_log("logged in: " .. tostring(client.session:is_logged_in()) .. ", back stack depth: " .. #client.backstack_manager._stack)
    trial_log("> client: backstack_manager:back()")
    env.app = client
    client.backstack_manager:back()
    trial_log("back stack depth: " .. #client.backstack_manager._stack)
    trial_log("> server frame")
    harness.frame(env, server)
    trial_log("> client frame")
    harness.frame(env, client)
    trial_log("logged in: " .. tostring(client.session:is_logged_in()) .. ", shown: " .. get_class_name_of(client.shown))
    trial_log("> client: connection_manager:remove(connection)")
    harness.disconnect(env, client, client_connection)
    trial_log("> server: connection_manager:remove(connection)")
    harness.disconnect(env, server, server_connection)
end

-- The input mixin needs a concrete class, as TextInput and TextButton are
-- in Treflove; `Test` prefix as Treflove's tests name their classes.
local TestInput = class("TestInput", Input)
scenario.TestInput = TestInput

---@param form_screen FormScreen
---@param name string
function TestInput:init(form_screen, name)
    self.name = name
    Input.init(self, form_screen)
end

local function names(inputs)
    local out = {}
    for i, input in ipairs(inputs) do
        out[i] = lifetime.alive(input) and input.name or tostring(lifetime.alive(input))
    end
    return "{" .. table.concat(out, ", ") .. "}"
end

-- Test case 2, first run: the input dies first; its hook unlinks it.
function scenario.input_first(harness, env)
    local form = FormScreen()
    local a = TestInput(form, "a")
    local b = TestInput(form, "b")
    local inputs = form._inputs
    trial_log("inputs: " .. names(inputs))
    trial_log("> destroy(a)")
    destroy(a)
    trial_log("inputs: " .. names(inputs) .. ", a alive: " .. tostring(lifetime.alive(a)) .. ", b alive: " .. tostring(lifetime.alive(b)))
    trial_log("> cleanup: destroy(form), destroy(b)")
    destroy(form)
    destroy(b)
end

-- Test case 2, second run: the form dies first; the hooks do nothing and
-- the inputs live on.
function scenario.form_first(harness, env)
    local form = FormScreen()
    local a = TestInput(form, "a")
    local b = TestInput(form, "b")
    local inputs = form._inputs
    trial_log("hooks on a: " .. #lifetime.dependents(a) .. ", on b: " .. #lifetime.dependents(b))
    trial_log("> destroy(form)")
    destroy(form)
    trial_log("inputs: " .. names(inputs) .. ", form alive: " .. tostring(lifetime.alive(form)))
    trial_log("hooks on a: " .. #lifetime.dependents(a) .. ", on b: " .. #lifetime.dependents(b))
    trial_log("> cleanup: destroy(a), destroy(b)")
    destroy(a)
    destroy(b)
end

-- Test case 2, third run: form and inputs die in one cascade, the inputs
-- owned by the form as a screen owns its widgets, the form by a period.
function scenario.one_cascade(harness, env)
    local period = lifetime.token("period")
    local form = FormScreen() @ period
    local a = TestInput(form, "a") @ form
    local b = TestInput(form, "b") @ form
    local inputs = form._inputs
    trial_log("> destroy(period)")
    destroy(period)
    trial_log("inputs: " .. names(inputs) .. ", form alive: " .. tostring(lifetime.alive(form)))
end

-- Test case 3: a session the server forgets without destroying it. The
-- connection, the session and everything under it are an ordinary cycle
-- (lesson 1 of xd/docs/09-lessons-from-treflove.md, reversed): two
-- collections run every release() and clear the weak entries.
-- Drops every reference the server holds to the connection and its
-- session, in a frame of its own so that no stack slot of the caller
-- still refers to them (docs/02-semantics.md, "Reachability is the
-- collector's": the collect is a statement of its own).
local function forget(server, in_channel, out_channel)
    local manager = server.connection_manager
    for connection in pairs(manager._connections) do
        server._sessions[connection] = nil
        manager._connections[connection] = nil
    end
    manager._by_in_channel[in_channel] = nil
    manager._by_out_channel[out_channel] = nil
end

function scenario.collected(harness, env)
    local server = harness.new_app(env, "server")
    local mocks = require("tests.lib.mocks")
    env.app = server
    local in_channel = mocks.make_channel()
    local out_channel = mocks.make_channel()
    server.connection_manager:add_connection(in_channel, mocks.make_thread(), out_channel, mocks.make_thread())
    trial_log("sessions: " .. count_entries(server._sessions) .. ", per-session upload entries: " .. count_entries(server.asset_manager._upload_asset_rp))
    trial_log("> the server drops the session from its table and forgets the connection, without destroy")
    forget(server, in_channel, out_channel)
    trial_log("> collectgarbage(\"collect\")")
    collectgarbage("collect")
    trial_log("> collectgarbage(\"collect\")")
    collectgarbage("collect")
    local assets = server.asset_manager
    local left = count_entries(assets._upload_asset_rp) + count_entries(assets._download_asset_rp) + count_entries(assets._download_missing_assets_rp)
    trial_log("per-session entries left: " .. left .. ", in channel released: " .. tostring(in_channel._released))
end

-- What Treflove's table helpers make of the state record a seen table
-- carries under its private key (docs/05-decisions.md, "The state
-- record's key is a private table").
function scenario.serializer(harness, env)
    local seen = {
        name = "adam",
        list = {1, 2}
    } @ lifetime.reachable
    local plain = {
        name = "adam",
        list = {1, 2}
    }
    local state_key = false
    for k in pairs(seen) do
        if lifetime.is_state(k) then
            state_key = true
        end
    end
    trial_log("pairs sees the state record: " .. tostring(state_key))
    trial_log("table.to_string equal to the unseen copy: " .. tostring(table.to_string(seen) == table.to_string(plain)))
    local back = table.from_string(table.to_string(seen))
    trial_log("table.from_string gives a plain table: " .. tostring(next(back, nil) ~= nil and back.name == "adam"))
    local copied = false
    for k in pairs(table.copy(seen)) do
        if lifetime.is_state(k) then
            copied = true
        end
    end
    trial_log("table.copy copies the state record: " .. tostring(copied))
    trial_log("table.is_empty of an empty seen table: " .. tostring(table.is_empty({} @ lifetime.reachable)))
end

return scenario
