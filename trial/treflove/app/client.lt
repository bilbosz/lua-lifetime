-- Excerpt of Treflove's app/client.lua: the two connection callbacks of
-- Client:load, as a function over the app. The connecting screen and the
-- quit entry of the back stack are outside the slice.
-- original/app/client.lua is the same excerpt of the hand-written code.
local Session = require("game.session")

---@class TrialClient
local Client = {}

---@param self AppMock
function Client.load(self)
    self.connection_manager:start(function(connection)
        -- lua-lifetime (idiom A): the session dies inside the connection's
        -- cascade.
        self.session = Session(connection) @ connection
    end, function()
        -- lua-lifetime: `self.session:release()` is gone. The two fields
        -- are still cleared by hand: a dead session is a tombstone, not nil
        -- (docs/02-semantics.md, "Tombstones").
        self.session = nil
        self.data = nil
    end)
end

return Client
