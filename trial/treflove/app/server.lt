-- Excerpt of Treflove's app/server.lua: the `_sessions` table of
-- Server:init and the two connection callbacks of Server:load, as a
-- function over the app. The rest of the class (App, screens, the save
-- file) is outside the slice. original/app/server.lua is the same excerpt
-- of the hand-written code.
local Session = require("game.session")

---@class TrialServer
local Server = {}

---@param self AppMock
function Server.load(self)
    self._sessions = {}
    self.connection_manager:start(function(connection)
        -- lua-lifetime (idiom A): the session dies inside the connection's
        -- cascade.
        self._sessions[connection] = Session(connection) @ connection
    end, function(connection)
        -- lua-lifetime: `self._sessions[connection]:release()` is gone; the
        -- entry is still removed by hand, since a dead connection is a
        -- tombstone and stays a key (docs/02-semantics.md, "Tombstones").
        self._sessions[connection] = nil
    end)
end

return Server
