-- exit_paths.tlt: examples/exit_paths.lt in Teal (task 018), without its
-- `goto` part: a block's scope ends on every ordinary exit path
-- (docs/04-transpiler.md, "Blocks: prologue and epilogue on every exit
-- path"): `return` evaluates its values first, then runs every epilogue
-- from the innermost block up to the function body, then returns the
-- values, trailing `nil`s included; `break` runs the epilogues of the
-- blocks between it and the loop body it leaves, innermost first.
--
-- A `return` that passes a call's or `...`'s values through an epilogue
-- is packed and unpacked; in Teal the unpacked values are cast to the
-- function's declared return types, here `any, any, any`
-- (docs/04-transpiler.md, "The Teal front end"), which `show` receives
-- as `...: any`.

local record Res
    name: string
end
local Res_mt = {
    __destroy = function(self: Res, reason: lifetime.Reason)
        print("destroy " .. self.name .. " (" .. reason .. ")")
    end
} as metatable<Res>
local function res(name: string): Res
    return setmetatable({name = name} as Res, Res_mt)
end

local function show(...: any)
    print("returned " .. select("#", ...) .. " values:", ...)
end

-- `return` from two blocks deep, in every shape.
local function leave(how: string, ...: any): any, any, any
    local a = res("a") @ lifetime.scope
    do
        local b = res("b") @ lifetime.scope
        if how == "two" then
            print("return 1, nil")
            return 1, nil
        elseif how == "names" then
            print("return b.name, a.name")
            return b.name, a.name
        elseif how == "call" then
            print("return select(2, ...)")
            return select(2, ...)
        elseif how == "vararg" then
            print("return ...")
            return ...
        elseif how == "none" then
            print("return")
            return
        end
        print("falls out of the inner block")
    end
    print("falls through the function body")
end
show(leave("two"))
show(leave("names"))
show(leave("call", "x", "y", nil, nil))
show(leave("vararg", nil, 2, nil))
show(leave("none"))
show(leave("other"))
--> return 1, nil
--> destroy b (anchor)
--> destroy a (anchor)
--> returned 2 values:	1	nil
--> return b.name, a.name
--> destroy b (anchor)
--> destroy a (anchor)
--> returned 2 values:	b	a
--> return select(2, ...)
--> destroy b (anchor)
--> destroy a (anchor)
--> returned 3 values:	y	nil	nil
--> return ...
--> destroy b (anchor)
--> destroy a (anchor)
--> returned 3 values:	nil	2	nil
--> return
--> destroy b (anchor)
--> destroy a (anchor)
--> returned 0 values:
--> falls out of the inner block
--> destroy b (anchor)
--> falls through the function body
--> destroy a (anchor)
--> returned 0 values:

-- A tuple cast as the last value is as many values as it names: the
-- values go through locals, no packing (docs/04-transpiler.md, "The Teal
-- front end").
local function pair(): string, integer
    local c = res("c") @ lifetime.scope
    return (function(): any, any return c.name, 2 end)() as (string, integer)
end
show(pair())
--> destroy c (anchor)
--> returned 2 values:	c	2

-- `break` from a block inside the loop body; a loop body is a block per
-- iteration.
for i = 1, 3 do
    local c = res("c" .. i) @ lifetime.scope
    do
        local d = res("d" .. i) @ lifetime.scope
        if i == 2 then
            print("break")
            break
        end
    end
    print("end of iteration " .. i)
end
print("after the for loop")
--> destroy d1 (anchor)
--> end of iteration 1
--> destroy c1 (anchor)
--> break
--> destroy d2 (anchor)
--> destroy c2 (anchor)
--> after the for loop

-- `break` from a `while` whose body has no record leaves only the block
-- that has one.
local n = 0
while true do
    n = n + 1
    if n == 2 then
        local e = res("e") @ lifetime.scope
        print("break from the then block")
        break
    end
end
print("after the while loop")
--> break from the then block
--> destroy e (anchor)
--> after the while loop
