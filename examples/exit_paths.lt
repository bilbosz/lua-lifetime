-- exit_paths.lt: a block's scope ends on every ordinary exit path
-- (docs/04-transpiler.md, "Blocks: prologue and epilogue on every exit
-- path"): `return` evaluates its values first, then runs every epilogue
-- from the innermost block up to the function body, then returns the
-- values, trailing `nil`s included; `break` runs the epilogues of the
-- blocks between it and the loop body it leaves, innermost first; a
-- `goto` (LuaJIT) those of the blocks it leaves.

local Res = {}
function Res.__destroy(self, reason)
    print("destroy " .. self.name .. " (" .. reason .. ")")
end
local function res(name)
    return setmetatable({name = name}, Res)
end

local function show(...)
    print("returned " .. select("#", ...) .. " values:", ...)
end

-- `return` from two blocks deep, in every shape.
local function leave(how, ...)
    local a = res("a") @ lifetime.scope
    do
        local b = res("b") @ lifetime.scope
        if how == "two" then
            print("return 1, nil")
            return 1, nil
        elseif how == "names" then
            print("return b.name, a.name")
            return b.name, a.name
        elseif how == "call" then
            print("return select(2, ...)")
            return select(2, ...)
        elseif how == "vararg" then
            print("return ...")
            return ...
        elseif how == "none" then
            print("return")
            return
        end
        print("falls out of the inner block")
    end
    print("falls through the function body")
end
show(leave("two"))
show(leave("names"))
show(leave("call", "x", "y", nil, nil))
show(leave("vararg", nil, 2, nil))
show(leave("none"))
show(leave("other"))
--> return 1, nil
--> destroy b (anchor)
--> destroy a (anchor)
--> returned 2 values:	1	nil
--> return b.name, a.name
--> destroy b (anchor)
--> destroy a (anchor)
--> returned 2 values:	b	a
--> return select(2, ...)
--> destroy b (anchor)
--> destroy a (anchor)
--> returned 3 values:	y	nil	nil
--> return ...
--> destroy b (anchor)
--> destroy a (anchor)
--> returned 3 values:	nil	2	nil
--> return
--> destroy b (anchor)
--> destroy a (anchor)
--> returned 0 values:
--> falls out of the inner block
--> destroy b (anchor)
--> falls through the function body
--> destroy a (anchor)
--> returned 0 values:

-- `break` from a block inside the loop body; a loop body is a block per
-- iteration.
for i = 1, 3 do
    local c = res("c" .. i) @ lifetime.scope
    do
        local d = res("d" .. i) @ lifetime.scope
        if i == 2 then
            print("break")
            break
        end
    end
    print("end of iteration " .. i)
end
print("after the for loop")
--> destroy d1 (anchor)
--> end of iteration 1
--> destroy c1 (anchor)
--> break
--> destroy d2 (anchor)
--> destroy c2 (anchor)
--> after the for loop

-- `break` from a `while` whose body has no record leaves only the block
-- that has one.
local n = 0
while true do
    n = n + 1
    if n == 2 then
        local e = res("e") @ lifetime.scope
        print("break from the then block")
        break
    end
end
print("after the while loop")
--> break from the then block
--> destroy e (anchor)
--> after the while loop

-- `goto` (LuaJIT): Lua 5.1 has no `goto`, and a chunk that contains one
-- does not compile there, so this part is a program in a string, built
-- with lifetime.cli and run only under LuaJIT. The output must be the
-- same under every interpreter (examples/README.md), so under Lua 5.1 the
-- lines LuaJIT prints are printed from GOTO_LOG; under LuaJIT they come
-- from the program.
local GOTO_PROGRAM = [[
local res = ...
for i = 1, 3 do
    local f = res("f" .. i) @ lifetime.scope
    if i == 2 then
        print("goto continue")
        goto continue
    end
    local g = res("g" .. i) @ lifetime.scope
    print("end of iteration " .. i)
    ::continue::
end
do
    local h = res("h") @ lifetime.scope
    do
        local k = res("k") @ lifetime.scope
        print("goto out")
        goto out
    end
end
::out::
print("after goto out")
]]
local GOTO_LOG = {
    "end of iteration 1",
    "destroy g1 (anchor)",
    "destroy f1 (anchor)",
    "goto continue",
    "destroy f2 (anchor)",
    "end of iteration 3",
    "destroy g3 (anchor)",
    "destroy f3 (anchor)",
    "goto out",
    "destroy k (anchor)",
    "destroy h (anchor)",
    "after goto out"
}
if jit then
    local cli = require("lifetime.cli")
    local program = assert(cli.build(GOTO_PROGRAM, "goto.lt"))
    assert(loadstring(program, "=goto.lt"))(res)
else
    print(table.concat(GOTO_LOG, "\n"))
end
--> end of iteration 1
--> destroy g1 (anchor)
--> destroy f1 (anchor)
--> goto continue
--> destroy f2 (anchor)
--> end of iteration 3
--> destroy g3 (anchor)
--> destroy f3 (anchor)
--> goto out
--> destroy k (anchor)
--> destroy h (anchor)
--> after goto out

-- Named block_exits.lt until task 008 gave that name to the port of
-- xd/examples/block_exits.xd (docs/07-conformance.md). This file is task
-- 006's test case 2: every shape of `return`, `break` and `goto`.
